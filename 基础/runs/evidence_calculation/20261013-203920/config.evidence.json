{
  "provider": "llama.cpp",
  "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
  "model": "Qwen3-0.6B-Q8_0",
  "parameters": {
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "min_p": 0,
    "presence_penalty": 1.5,
    "seed": 42,
    "max_tokens": 512,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "schema": {
          "type": "object",
          "properties": {
            "target_scope": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "passage_id": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "data",
                      "rule",
                      "missing_check"
                    ]
                  }
                },
                "required": [
                  "passage_id",
                  "quote",
                  "role"
                ],
                "additionalProperties": false
              }
            },
            "calculation": {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "none",
                    "add",
                    "subtract",
                    "multiply",
                    "divide"
                  ]
                },
                "operands": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "passage_id": {
                        "type": "string"
                      },
                      "meaning": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value",
                      "passage_id",
                      "meaning",
                      "unit"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "operation",
                "operands"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "target_scope",
            "evidence",
            "calculation"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "timeout_seconds": 180
}
