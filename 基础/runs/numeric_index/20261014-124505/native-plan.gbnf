char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
expression ::= null | expression-1
expression-1 ::= ref-defs-expr4
expression-kv ::= "\"expression\"" space ":" space expression
mode ::= ("\"no_calculation\"" | "\"insufficient\"" | "\"calculate\"")
mode-kv ::= "\"mode\"" space ":" space mode
null ::= "null"
ref-defs-expr0 ::= ref-defs-expr0-0 | ref-defs-expr0-1
ref-defs-expr0-0 ::= "{" space ref-defs-expr0-0-number-ref-kv space "}"
ref-defs-expr0-0-number-ref-kv ::= "\"number_ref\"" space ":" space string
ref-defs-expr0-1 ::= "{" space ref-defs-expr0-1-constant-kv space "}"
ref-defs-expr0-1-constant ::= ("100")
ref-defs-expr0-1-constant-kv ::= "\"constant\"" space ":" space ref-defs-expr0-1-constant
ref-defs-expr1 ::= ref-defs-expr1-0 | ref-defs-expr1-1 | ref-defs-expr1-2
ref-defs-expr1-0 ::= "{" space ref-defs-expr1-0-number-ref-kv space "}"
ref-defs-expr1-0-number-ref-kv ::= "\"number_ref\"" space ":" space string
ref-defs-expr1-1 ::= "{" space ref-defs-expr1-1-constant-kv space "}"
ref-defs-expr1-1-constant ::= ("100")
ref-defs-expr1-1-constant-kv ::= "\"constant\"" space ":" space ref-defs-expr1-1-constant
ref-defs-expr1-2 ::= "{" space ref-defs-expr1-2-op-kv "," space ref-defs-expr1-2-args-kv space "}"
ref-defs-expr1-2-args ::= "[" space ref-defs-expr1-2-args-item ("," space ref-defs-expr1-2-args-item){1,1} space "]"
ref-defs-expr1-2-args-item ::= ref-defs-expr0
ref-defs-expr1-2-args-kv ::= "\"args\"" space ":" space ref-defs-expr1-2-args
ref-defs-expr1-2-op ::= ("\"add\"" | "\"subtract\"" | "\"multiply\"" | "\"divide\"")
ref-defs-expr1-2-op-kv ::= "\"op\"" space ":" space ref-defs-expr1-2-op
ref-defs-expr2 ::= ref-defs-expr2-0 | ref-defs-expr2-1 | ref-defs-expr2-2
ref-defs-expr2-0 ::= "{" space ref-defs-expr2-0-number-ref-kv space "}"
ref-defs-expr2-0-number-ref-kv ::= "\"number_ref\"" space ":" space string
ref-defs-expr2-1 ::= "{" space ref-defs-expr2-1-constant-kv space "}"
ref-defs-expr2-1-constant ::= ("100")
ref-defs-expr2-1-constant-kv ::= "\"constant\"" space ":" space ref-defs-expr2-1-constant
ref-defs-expr2-2 ::= "{" space ref-defs-expr2-2-op-kv "," space ref-defs-expr2-2-args-kv space "}"
ref-defs-expr2-2-args ::= "[" space ref-defs-expr2-2-args-item ("," space ref-defs-expr2-2-args-item){1,1} space "]"
ref-defs-expr2-2-args-item ::= ref-defs-expr1
ref-defs-expr2-2-args-kv ::= "\"args\"" space ":" space ref-defs-expr2-2-args
ref-defs-expr2-2-op ::= ("\"add\"" | "\"subtract\"" | "\"multiply\"" | "\"divide\"")
ref-defs-expr2-2-op-kv ::= "\"op\"" space ":" space ref-defs-expr2-2-op
ref-defs-expr3 ::= ref-defs-expr3-0 | ref-defs-expr3-1 | ref-defs-expr3-2
ref-defs-expr3-0 ::= "{" space ref-defs-expr3-0-number-ref-kv space "}"
ref-defs-expr3-0-number-ref-kv ::= "\"number_ref\"" space ":" space string
ref-defs-expr3-1 ::= "{" space ref-defs-expr3-1-constant-kv space "}"
ref-defs-expr3-1-constant ::= ("100")
ref-defs-expr3-1-constant-kv ::= "\"constant\"" space ":" space ref-defs-expr3-1-constant
ref-defs-expr3-2 ::= "{" space ref-defs-expr3-2-op-kv "," space ref-defs-expr3-2-args-kv space "}"
ref-defs-expr3-2-args ::= "[" space ref-defs-expr3-2-args-item ("," space ref-defs-expr3-2-args-item){1,1} space "]"
ref-defs-expr3-2-args-item ::= ref-defs-expr2
ref-defs-expr3-2-args-kv ::= "\"args\"" space ":" space ref-defs-expr3-2-args
ref-defs-expr3-2-op ::= ("\"add\"" | "\"subtract\"" | "\"multiply\"" | "\"divide\"")
ref-defs-expr3-2-op-kv ::= "\"op\"" space ":" space ref-defs-expr3-2-op
ref-defs-expr4 ::= ref-defs-expr4-0 | ref-defs-expr4-1 | ref-defs-expr4-2
ref-defs-expr4-0 ::= "{" space ref-defs-expr4-0-number-ref-kv space "}"
ref-defs-expr4-0-number-ref-kv ::= "\"number_ref\"" space ":" space string
ref-defs-expr4-1 ::= "{" space ref-defs-expr4-1-constant-kv space "}"
ref-defs-expr4-1-constant ::= ("100")
ref-defs-expr4-1-constant-kv ::= "\"constant\"" space ":" space ref-defs-expr4-1-constant
ref-defs-expr4-2 ::= "{" space ref-defs-expr4-2-op-kv "," space ref-defs-expr4-2-args-kv space "}"
ref-defs-expr4-2-args ::= "[" space ref-defs-expr4-2-args-item ("," space ref-defs-expr4-2-args-item){1,1} space "]"
ref-defs-expr4-2-args-item ::= ref-defs-expr3
ref-defs-expr4-2-args-kv ::= "\"args\"" space ":" space ref-defs-expr4-2-args
ref-defs-expr4-2-op ::= ("\"add\"" | "\"subtract\"" | "\"multiply\"" | "\"divide\"")
ref-defs-expr4-2-op-kv ::= "\"op\"" space ":" space ref-defs-expr4-2-op
root ::= "{" space mode-kv "," space expression-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
