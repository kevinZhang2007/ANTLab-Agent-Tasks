answer-kv ::= "\"answer\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
citations ::= "[" space (string ("," space string)*)? space "]"
citations-kv ::= "\"citations\"" space ":" space citations
root ::= "{" space answer-kv "," space citations-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
