+    export = offset(struct.unpack_from('<I', raw, pe + 24 + 112)[0])
+    n = struct.unpack_from('<I', raw, export + 24)[0]
+    names = offset(struct.unpack_from('<I', raw, export + 32)[0])
+    result = []
