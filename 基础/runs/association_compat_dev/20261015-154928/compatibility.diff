+
+def counted_declaration(text, match):
+    predicate = COUNTED_DECLARATION.match(text[match.end():])
+    if not predicate:
+        return None
+    # 只兼容明示已经发生的声明；假设、提及和否定语境不能升级为主声明。
+    clause = extraction.statement(text, match.start(), match.end())
