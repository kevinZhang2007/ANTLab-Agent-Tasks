+def spans(text):
+    if not text:return []
+    result=[];start=0;i=0
+    while i<len(text):
+        char=text[i];boundary=char in '。！？!?'
+        if char=='.':
+            before=text[:i];last=re.search(r'[^\s]+$',before);token=last.group() if last else ''
+            word=re.search(r'(?:[A-Za-z]\.)*[A-Za-z]+$',before);word=word.group().casefold() if word else ''
