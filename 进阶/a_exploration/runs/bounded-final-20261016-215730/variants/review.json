        {
          "sentence_id": "sent-0010",
          "block_id": "P1-S09-p01",
          "doc_id": "P1",
          "snapshot": "published",
          "text": "We find hypertext (i.e., html file output) to be particularly useful for this purpose. ",
          "start": 731,
          "end": 818,
          "offset_unit": "unicode_code_point",
          "interval": "[start,end)",
