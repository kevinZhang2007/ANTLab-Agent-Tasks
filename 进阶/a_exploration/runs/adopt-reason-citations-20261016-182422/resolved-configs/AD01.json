{
  "provider": "llama.cpp",
  "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
  "model": "Qwen3-0.6B-Q8_0",
  "parameters": {
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "min_p": 0,
    "presence_penalty": 1.5,
    "seed": 42,
    "max_tokens": 1024,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "schema": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "enum": [
                "supported",
                "contradicted",
                "insufficient"
              ]
            },
            "reason": {
              "type": "string"
            },
            "sentence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "sent-0001",
                  "sent-0002",
                  "sent-0003",
                  "sent-0004",
                  "sent-0005",
                  "sent-0006",
                  "sent-0007",
                  "sent-0008",
                  "sent-0009",
                  "sent-0010",
                  "sent-0011"
                ]
              }
            }
          },
          "required": [
            "label",
            "reason",
            "sentence_ids"
          ],
          "additionalProperties": false
        }
      }
    },
    "chat_template_kwargs": {
      "enable_thinking": true
    }
  },
  "timeout_seconds": 180
}